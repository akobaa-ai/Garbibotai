/* ===================== ROOT ===================== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  background-color: #eef6f8;
  color: #023047;
  line-height: 1.6;
}

header.header {
  background: linear-gradient(135deg, #219ebc, #023047);
  text-align: center;
  padding: 40px 20px;
  color: white;
}

header.header h1 {
  font-size: 2.8em;
  margin-bottom: 10px;
}

header.header p {
  font-size: 1.2em;
}

/* ===================== SECCIONES ===================== */
.section {
  max-width: 1000px;
  margin: 40px auto;
  padding: 20px;
}

.section h2 {
  color: #219ebc;
  margin-bottom: 12px;
}

.section p {
  margin-bottom: 12px;
  font-size: 1em;
}

/* ===================== GALERÍA ===================== */
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
  margin-top: 15px;
}

.gallery img,
.gallery video {
  width: 100%;
  border-radius: 10px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  display: block;
}

/* ===================== PIE ===================== */
.footer {
  background-color: #023047;
  color: white;
  text-align: center;
  padding: 15px;
}
